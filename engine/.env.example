# 复制为 .env 并填入真实值即可（.env 已被 .gitignore 忽略，不会入库）
# 也可直接在终端设置这些环境变量，效果相同。

# ===== 必填：任意一家兼容 OpenAI Chat Completions 协议的网关密钥 =====
# 没有凭证时引擎会直接报错退出（不再有 mock 兜底）
OPENAI_API_KEY=sk-xxxx

# ===== 选填：模型与网关（不设则用下方 --provider 预设默认值）=====
# 模型名（不同供应商不同，例如 gpt-4o-mini / deepseek-chat / qwen-plus / qwen2.5:7b）
OPENAI_MODEL=
# 兼容网关 base_url（官方 OpenAI 可留空）
OPENAI_BASE_URL=

# ===== 一键切换供应商：运行时不传也可，但设了更省事 =====
#   deepseek -> https://api.deepseek.com/v1        模型 deepseek-chat
#   qwen     -> https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#   ollama   -> http://localhost:11434/v1          模型 qwen2.5:7b（本地，无需 Key，会自动填占位）
# 例：python run.py --provider deepseek --job jobs/backend-senior.json --inputs ../inputs

# ===== 运行姿势 =====
# 真实 LLM：      OPENAI_API_KEY=sk-xxx python run.py --provider deepseek --job jobs/backend-senior.json --inputs ../inputs
# 本地 Ollama：   python run.py --provider ollama --job jobs/backend-senior.json --inputs ../inputs

# ===== ★ WorkBuddy 反代（复用 WorkBuddy 桌面端账号积分，无需 API Key）=====
# 前置：本机已安装并登录 WorkBuddy 桌面端。
#   python run.py --provider workbuddy --job jobs/backend-senior.json --inputs ../inputs
#   python run.py --list-workbuddy-models    # 账号可用模型 + 积分倍率
#   python run.py --workbuddy-credits        # 剩余积分明细
#   python run.py --test-workbuddy --model glm-5.3   # 只测该模型能否连通
# 可选覆盖（一般不需要）：
#   WORKBUDDY_APP_EXECUTABLE=C:\Program Files\WorkBuddy\WorkBuddy.exe
#   WORKBUDDY_AUTH_FILE=...    # 自定义 workbuddy-desktop.info 路径
# 说明：凭证只在本机内存中解密，不落盘；默认模型 deepseek-v4-pro。
